msgstr ""
"Actualiza `A-O_Demand.xlsx` (si la integración de demanda está "
"habilitada)."

#: ../../secondary-techs-editor.md:142
msgid "Sets `Projection.Mode` to \"User defined\" for modified parameters."
msgstr ""
"Establece `Projection.Mode` en \"User defined\" para los parámetros "
"modificados."

